{
    "manifest_version": 3,
    "name": "Listing Assistant for Cardmarket",
    "version": "1.1.0",
    "description": "Pick a card from your ManaBox CSV and get Cardmarket's list-product form filled for it.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://api.scryfall.com/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "listing-assistant-for-cardmarket@benroe.github.io",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "background": {
        "service_worker": "js/background.js",
        "scripts": [
            "js/background.js"
        ]
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.cardmarket.com/*/Magic/*"
            ],
            "js": [
                "lib/papaparse.min.js",
                "js/shared.js",
                "js/content.js"
            ],
            "css": [
                "css/panel.css"
            ]
        }
    ]
}
